                            <div style="align-content: center; text-align: right">
                                <div class="left">
                                    <asp:Label runat="server" ID="lblDisplayName" Text=""></asp:Label>

                                </div>
                                <div class="right">
                                    <asp:Label ID="lblversion" runat="server" Text="(Version 1.1)"> </asp:Label>
                                </div>
                                <div class="center">
                                    <div id="showtime"></div>
                                    <asp:Label ID="lblTimerRefreshInfo" runat="server"></asp:Label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <asp:ContentPlaceHolder ID="Contenedor" runat="server">
                </asp:ContentPlaceHolder>
                <asp:UpdatePanel runat="server">
                    <ContentTemplate></ContentTemplate>
                    <Triggers>
                    </Triggers>

                </asp:UpdatePanel>

            </div>
        </form>

        <footer class="main-footer">
        </footer>

        <div class="control-sidebar-bg"></div>
