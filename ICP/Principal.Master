                                    <span>DisplayAll</span>
                                    <span class="">
                                        <i class=""></i>
                                    </span>
                                </a>
                            </li>
                            <li class="dropdown">
                                <a href="PCIShipments.aspx?menuPCI=2" class="dropbtn">
                                    <i class="fa fa-truck"></i>
                                    <span>Shiping & Receiving</span>
                                </a>
                                <div class="dropdown-content">
                                    <a href="PCIShipments.aspx?menuPCI=2"><i class="fa fa-binoculars"></i>Shipments</a>
